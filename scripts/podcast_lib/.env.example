# Secrets for the SIB podcast post-processing pipeline.
#
# Loaded automatically by podcast.py via python-dotenv at this path:
#   scripts/podcast_lib/.env
#
# Setup:
# 1. Copy this file to scripts/podcast_lib/.env
# 2. Fill in the values below
# 3. The .env file is gitignored — never commit it
#
# ---------------------------------------------------------------
# HF_TOKEN — Hugging Face access token (read scope is enough)
# ---------------------------------------------------------------
# Required only the FIRST time you run the pipeline on a machine,
# to download the gated pyannote diarization weights. Once cached
# at ~/.cache/huggingface/hub/, you can run with HF_HUB_OFFLINE=1
# instead of supplying a token.
#
# 1. Mint a token: https://huggingface.co/settings/tokens
# 2. Accept the gated terms at BOTH model pages:
#    - https://huggingface.co/pyannote/speaker-diarization-community-1
#    - https://huggingface.co/pyannote/segmentation-community-1
HF_TOKEN=

# ---------------------------------------------------------------
# Postiz — social-media scheduler (self-hosted)
# ---------------------------------------------------------------
# Used by `podcast publish-youtube` and `podcast publish-postiz` to
# upload videos and schedule posts to LinkedIn / X / IG / TikTok / FB
# / YouTube. Postiz lives on the EvoGyms tailnet — you must be
# connected to Tailscale before any publish command will work.
#
# Get the API key: Postiz UI → Settings → API → "Generate new key".
# The key is per-user (ctindel@gmail.com), not org-wide.
POSTIZ_BASE_URL=http://postiz-tailscale.tailf1ef2f.ts.net
POSTIZ_TOKEN=

# ---------------------------------------------------------------
# Spotify for Creators (formerly Anchor) — episode upload via headless browser
# ---------------------------------------------------------------
# Used by `podcast publish-spotify`. There is NO Spotify upload API,
# so the script drives the dashboard via agent-browser.
#
# Spotify uses email + password login by default. If 2FA is enabled
# on the account, the script will prompt for the SMS code on stdin —
# or set SPOTIFY_2FA_CODE env-var inline before invoking the script.
SPOTIFY_EMAIL=
SPOTIFY_PASSWORD=
