{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIB Episode Metadata",
  "description": "Schema for SIB_ENN_metadata.yaml — the canonical metadata file for each podcast episode.",
  "type": "object",
  "required": ["schema_version", "episode"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "episode": {
      "type": "object",
      "required": ["number", "tagline", "tagline_highlight"],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer"
        },
        "posting_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "duration": {
          "type": "string"
        },
        "hugo_title": {
          "type": "string"
        },
        "tagline": {
          "type": "string",
          "minLength": 1,
          "description": "Provocative quote for thumbnails. MUST NOT be empty — thumbnail generation will fail without it."
        },
        "tagline_highlight": {
          "type": "string",
          "description": "Pipe-delimited phrases to highlight in the tagline. Empty string means no highlights."
        },
        "guest": {
          "type": "object",
          "required": ["slug", "full_name"],
          "additionalProperties": false,
          "properties": {
            "slug": { "type": "string" },
            "full_name": { "type": "string" },
            "full_title": { "type": "string" },
            "short_title": { "type": "string" },
            "company": { "type": "string" },
            "headshot_original": { "type": "string" },
            "headshot_bg_removed": { "type": "string" },
            "twitter_handle": { "type": "string" },
            "twitter_title": { "type": "string" }
          }
        },
        "hosts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "balloon_no_overlay": { "type": "string" },
            "balloon_with_overlay": { "type": "string" },
            "podcast_cover_canonical": { "type": "string" }
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "youtube_full": { "type": "string" },
            "spotify": { "type": "string" },
            "apple_podcasts": { "type": "string" },
            "posted_tiktok": { "type": "string" },
            "posted_linkedin": { "type": "string" },
            "posted_youtube_text": { "type": "string" }
          }
        },
        "long_description": { "type": "string" },
        "links_mentioned": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "twitter_topic": { "type": "string" },
        "show_notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["urls"],
            "additionalProperties": false,
            "properties": {
              "heading": { "type": "string" },
              "urls": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "timestamp_start", "timestamp_end", "description"],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "timestamp_start": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}:\\d{2}$"
          },
          "timestamp_end": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}:\\d{2}$"
          },
          "quote_starts_with": { "type": "string" },
          "quote_ends_with": { "type": "string" },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "overlay_text": { "type": "string" },
          "overlay_highlight": {
            "type": "string",
            "description": "Phrase within overlay_text to highlight. Required when overlay_text is non-empty."
          },
          "links": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "youtube": { "type": "string" },
              "posted_tiktok": { "type": "string" },
              "posted_linkedin": { "type": "string" },
              "posted_twitter": { "type": "string" }
            }
          }
        }
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "footer": { "type": "string" },
        "clip_long": { "type": "string" },
        "clip_twitter": { "type": "string" },
        "episode_long": { "type": "string" },
        "episode_twitter": { "type": "string" }
      }
    }
  }
}
